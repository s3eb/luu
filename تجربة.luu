-- 1. تعريف متغيرات واستخدام القواعد الشرطية والمنطقية
وطّن النتيجة = صواب
وطّن نص_تجريبي = "لغة luu"

إذ النتيجة == صواب و لا خطأ إذًا
    اطبع("1. نجاح اختبار القواعد والرموز المنطقية")
أنهِ

-- 2. تعريف دالة واختبار المعاملات والمصفوفات
دُل حساب_المجموع(أ، ب)
    أرجع أ + ب
أنهِ

وطّن مجموع = حساب_المجموع(10، 20)
إذ مجموع == 30 إذًا
    اطبع("2. نجاح استدعاء الدوال والفاصلة العربية")
أنهِ

-- 3. اختبار الجداول (Tables) ودوال التكرار والكلمة المفتاحية (في)
وطّن مصفوفة = {"الأول"، "الثاني"، "الثالث"}

لـ مفتاح، قيمة في أزواج(مصفوفة) كرر
    إذ مفتاح == 2 إذًا
        اطبع("3. نجاح حلقة التكرار (في) والأزواج:")
        اطبع(قيمة)
    أنهِ
أنهِ

-- 4. اختبار حلقات التكرار (لطالما) و (لـ)
وطّن عداد = 1
لطالما عداد <= 2 كرر
    عداد = عداد + 1
أنهِ

لـ س = 1، 1 كرر
    اطبع("4. نجاح تنفيذ حلقة (لطالما) وحلقة (لـ)")
أنهِ

-- 5. اختبار الجداول الفائقة (Metatables) والرموز الجريئة (آتنِ / أفلت)
وطّن جدول_أصلي = {}
وطّن جدول_قواعد = {}

جدول_فائقًا(جدول_أصلي، جدول_قواعد)

إذ لا (جدول_فائق(جدول_أصلي) == عدم) إذًا
    اطبع("5. نجاح تعيين وفحص الجدول الفائق (جدول_فائقًا)")
أنهِ

أفلت(جدول_أصلي، "مفتاح_خام"، "قيمة_خام")
وطّن قيمة_مسترجعة = آتنِ(جدول_أصلي، "مفتاح_خام")

إذ قيمة_مسترجعة == "قيمة_خام" إذًا
    اطبع("6. نجاح معالجة (أفلت) و(آتنِ) للوصول المباشر")
أنهِ

-- 6. اختبار مكتبة النظام (فالمشغل) والوقت
وطّن الوقت_الحالي = الوقت.فالمشغل()
إذ لا (الوقت_الحالي == عدم) إذًا
    اطبع("7. نجاح الاستعلام عن النظام عبر (الوقت.فالمشغل):")
    اطبع(الوقت_الحالي)
أنهِ
